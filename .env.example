# Copy to .env and fill in. Nothing here is a real secret.

# ---- API ----
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ---- Qdrant ----
QDRANT_URL=http://qdrant:6333
STATUTE_COLLECTION=bnss_statute
DOCS_COLLECTION=user_docs

# ---- Redis / queue ----
REDIS_URL=redis://redis:6379

# ---- Embeddings (open weight, self hosted via HF text-embeddings-inference) ----
EMBEDDING_URL=http://embeddings:80
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
# bge-v1.5 wants this prefix on the QUERY side only. Passages go in raw.
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBEDDING_BATCH_SIZE=32

# ---- Reranker (optional, off by default) ----
RERANK_ENABLED=false
RERANKER_URL=http://reranker:80

# ---- LLM provider (swappable: gemini | openrouter | groq | ollama) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=http://ollama:11434

# ---- Retrieval tuning ----
RETRIEVAL_TOP_K=8
CANDIDATE_POOL=40
RRF_K=60
# below this fused score the bot refuses instead of guessing
CONFIDENCE_THRESHOLD=0.02

# ---- Limits ----
MAX_UPLOAD_MB=25
CHAT_RATE_LIMIT_PER_MIN=20
UPLOAD_RATE_LIMIT_PER_HOUR=10

# ---- Corpus ----
DATA_DIR=/app/data
SOURCE_PDF=/app/data/raw/bnss-2023.pdf
SOURCE_URI=https://drive.google.com/file/d/1mjs9lsMF0PtSsbQgz4-UcEHlyIvAzZ6o/view
FORMS_PAGE_START=190
FORMS_PAGE_END=249

# ---- Cost tracking (per 1M tokens, used by /api/v1/metrics) ----
COST_PER_1M_INPUT=0.10
COST_PER_1M_OUTPUT=0.40
