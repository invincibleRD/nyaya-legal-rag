# copy to .env before running anything

NODE_ENV=development
PORT=8000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# public origin the browser hits, baked into the frontend bundle at build time
PUBLIC_URL=http://localhost:8000

QDRANT_URL=http://qdrant:6333
STATUTE_COLLECTION=bnss_statute
DOCS_COLLECTION=user_docs

REDIS_URL=redis://redis:6379

# embeddings run locally, no hosted embedding API
EMBEDDING_URL=http://embeddings:80
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
# bge wants this on queries only, passages go in raw
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages:"
EMBEDDING_BATCH_SIZE=32

# cross encoder over the shortlist, the single biggest win on retrieval quality
# gpu image tag, only used by docker-compose.gpu.yml
TEI_GPU_TAG=86-1.7

RERANK_ENABLED=true
RERANKER_URL=http://reranker:80
# 6 candidates full length beats 12 truncated, and costs half the time
RERANK_POOL=6
RERANK_MAX_CHARS=1800

# gemini | openrouter | groq | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=http://ollama:11434

RETRIEVAL_TOP_K=8
CANDIDATE_POOL=40
# rrf at k=60 barely separates rank 1 from rank 10, so a passage only one leg
# found loses to a mediocre one both found. 20 sharpens that back up.
RRF_K=20
# cosine of the best hit, below this the bot refuses instead of guessing.
# measured on this corpus: in scope questions land 0.62-0.80, out of scope 0.37-0.53
CONFIDENCE_THRESHOLD=0.58

MAX_UPLOAD_MB=25
CHAT_RATE_LIMIT_PER_MIN=20
UPLOAD_RATE_LIMIT_PER_HOUR=10

DATA_DIR=/app/data
SOURCE_PDF=/app/data/raw/bnss-2023.pdf
SOURCE_URI=https://drive.google.com/file/d/1mjs9lsMF0PtSsbQgz4-UcEHlyIvAzZ6o/view
FORMS_PAGE_START=190
FORMS_PAGE_END=249

# per 1M tokens, used for the cost gauge
COST_PER_1M_INPUT=0.10
COST_PER_1M_OUTPUT=0.40
