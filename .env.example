# copy to .env before running anything

NODE_ENV=development
PORT=8000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# proxies in front of the app, counted from the socket inwards. never `true`,
# which would let any client forge X-Forwarded-For and its own rate limit bucket.
# 0 for local dev. production is gclb -> nginx -> app: the app sees
# "<client>,<gclb>, <gfe>" in X-Forwarded-For, so the client ip is 3 hops in.
TRUST_PROXY_HOPS=0
# public origin the browser hits, baked into the frontend bundle at build time
PUBLIC_URL=http://localhost:8000

QDRANT_URL=http://qdrant:6333
STATUTE_COLLECTION=bnss_statute
DOCS_COLLECTION=user_docs

REDIS_URL=redis://redis:6379
# false makes every redis backed limit fall back to an in-process counter
REDIS_ENABLED=true

# embeddings run locally, no hosted embedding API
EMBEDDING_URL=http://embeddings:80
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
# bge wants this on queries only, passages go in raw
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages:"
EMBEDDING_BATCH_SIZE=32

# cross encoder over the shortlist, the single biggest win on retrieval quality
# gpu image tag, only used by docker-compose.gpu.yml
TEI_GPU_TAG=86-1.7

RERANK_ENABLED=true
RERANKER_URL=http://reranker:80
# measured on the deployed gpu: 12 full passages beat 6 (hit@1 0.80 vs 0.72,
# MRR 0.831 vs 0.765) for 5ms. 25 and 40 are both worse than 12.
RERANK_POOL=12
RERANK_MAX_CHARS=1800

# gemini | openrouter | groq | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=http://ollama:11434

RETRIEVAL_TOP_K=8
CANDIDATE_POOL=40
# rrf at k=60 barely separates rank 1 from rank 10, so a passage only one leg
# found loses to a mediocre one both found. 20 sharpens that back up.
RRF_K=20
# cosine of the best hit, below this the bot refuses instead of guessing.
# measured on this corpus: in scope questions land 0.62-0.80, out of scope 0.37-0.53
CONFIDENCE_THRESHOLD=0.58
# a file the user uploaded is in scope by their choice, and short documents in
# ordinary words score lower than statute prose. measured on an uploaded page:
# answerable 0.44-0.61, unanswerable 0.29-0.30 or no document hit at all.
DOCUMENT_CONFIDENCE_THRESHOLD=0.38

MAX_UPLOAD_MB=25

# per session, the friendly first message. the session id is client chosen, so
# these are ux only and are never the thing holding an attacker back.
CHAT_RATE_LIMIT_PER_MIN=20
UPLOAD_RATE_LIMIT_PER_HOUR=10

# per client ip, the budget that actually holds. needs TRUST_PROXY_HOPS right.
GLOBAL_RATE_LIMIT_PER_MIN=300
CHAT_RATE_LIMIT_PER_IP_PER_MIN=10
# gpu embed plus cross encoder rerank on every call
SEARCH_RATE_LIMIT_PER_IP_PER_MIN=20
UPLOAD_RATE_LIMIT_PER_IP_PER_HOUR=10
# ~29MB of zip per call, so bandwidth amplification
DOWNLOAD_ALL_RATE_LIMIT_PER_IP_PER_HOUR=3

# simultaneous open answer streams, which a per minute counter cannot see
MAX_CONCURRENT_CHAT_PER_IP=2
MAX_CONCURRENT_CHAT_TOTAL=12

# stops one session filling redis on its own
MAX_CONVERSATIONS_PER_SESSION=50
MAX_DOCUMENTS_PER_SESSION=20

DATA_DIR=/app/data
SOURCE_PDF=/app/data/raw/bnss-2023.pdf
SOURCE_URI=https://drive.google.com/file/d/1mjs9lsMF0PtSsbQgz4-UcEHlyIvAzZ6o/view
FORMS_PAGE_START=190
FORMS_PAGE_END=249

# per 1M tokens, used for the cost gauge
COST_PER_1M_INPUT=0.10
COST_PER_1M_OUTPUT=0.40
# rolling utc day ceiling, chat returns 503 above it. 0 disables the breaker.
DAILY_COST_CEILING_USD=5
